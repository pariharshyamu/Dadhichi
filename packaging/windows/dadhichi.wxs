<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX v4 installer definition for Dadhichi.

  Build (on Windows, with the WiX toolset installed):
    wix build packaging/windows/dadhichi.wxs ^
      -d BinDir=target\release ^
      -d Version=0.1.1 ^
      -o dist\dadhichi-x86_64.msi

  The BinDir and Version values are supplied at build time by the release
  workflow so the manifest never hard-codes a version.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Dadhichi"
           Manufacturer="Dadhichi contributors"
           Version="$(var.Version)"
           UpgradeCode="6f9d2c8a-1b4e-4e2a-9c3d-7a1e5b0f8c2d"
           Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Dadhichi is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Install the CLI and put it on the system PATH. -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Dadhichi">
        <Component Id="DadhichiExe" Guid="*">
          <File Id="DadhichiExe"
                Source="$(var.BinDir)\dadhichi.exe"
                KeyPath="yes" />
          <Environment Id="PathEntry"
                       Name="PATH"
                       Value="[INSTALLFOLDER]"
                       Permanent="no"
                       Part="last"
                       Action="set"
                       System="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="Dadhichi" Level="1">
      <ComponentRef Id="DadhichiExe" />
    </Feature>
  </Package>
</Wix>
